// Current AIGT code architecture, source v23. Capability is not activation.
digraph TradingArchitecture {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.65", fontname="Helvetica Neue"];
  node [shape=box, style="rounded,filled", color="#223047", fillcolor="#F5F7FA", fontname="Helvetica Neue", fontsize=10, margin="0.14,0.09"];
  edge [color="#65738A", penwidth=1.2, arrowsize=0.7, fontname="Helvetica Neue", fontsize=9];
  sources [label="Binance research data\nDEX / context / news (read-only)"];
  collectors [label="Multi-asset collectors\nClosed UTC 4h/8h/1d, Perp 1h"];
  jev [label="Scoped rule + Jev\nPerp 30s / Spot setup", fillcolor="#E8F0FC"];
  llm [label="Hourly LLM analysis\nBounded per-asset proposals"];
  lifecycle [label="Replay / soak / manual promotion\nIndependent symbol + scope", fillcolor="#F5EFD9"];
  source [shape=cylinder, label="Source SQLite v23\nCatalog / signals / evaluations"];
  operator [label="Operator approval\nSeparate execution activation"];
  web [label="Dashboard / CLI\nUI UTC+7 / guarded controls"];
  runtime [label="Multi Demo runtime (opt-in)\nAllocation / reconcile / protect / risk", fillcolor="#F7E5E5"];
  adapter [label="ExecutionAdapter\nBinance Demo Spot / USD-M Perp"];
  demo [label="Binance Demo account\nNo mainnet execution", fillcolor="#E7F4EC"];
  journal [shape=cylinder, label="Separate execution journal\nDurable intents / orders / fills"];
  legacy [label="Legacy BTC paper simulator\nNo exchange orders"];
  future [label="Hyperliquid execution\nNot implemented", style="rounded,dashed"];
  sources -> collectors -> jev -> source;
  collectors -> llm -> lifecycle -> source;
  operator -> lifecycle [label="approve"];
  source -> web [label="projection"];
  source -> runtime [label="read-only"];
  operator -> runtime [label="activation"];
  runtime -> journal [label="persist before submit"];
  runtime -> adapter -> demo [label="Demo API"];
  source -> legacy [label="separate simulated path"];
  future -> adapter [style=dashed, label="future module; no route today"];
}
