# Intraday v1 is deliberately paper-only and BTCUSDT-only.
INTRADAY_MODE=paper
INTRADAY_PROVIDER=stub
INTRADAY_SYMBOL=BTCUSDT
INTRADAY_PAPER_BALANCE=10000
INTRADAY_INTERVAL_SECONDS=5
INTRADAY_DATABASE=/app/state/intraday/intraday.sqlite3
INTRADAY_LLM_ANALYSIS_INTERVAL=3600
# Host directory bind used by Docker Compose. Its profile file must have mode 0600.
INTRADAY_PROVIDER_SECRETS_HOST_DIR=../../state/provider-secrets
INTRADAY_DASHBOARD_HOST=0.0.0.0
INTRADAY_DASHBOARD_PORT=8081

# Generate a long random value. This protects mutation endpoints; it is never shown by the UI.
INTRADAY_CONTROL_TOKEN=replace-with-a-long-random-token
INTRADAY_NEWS_ENABLED=true
INTRADAY_NEWS_INTERVAL_SECONDS=1800

# Cross-venue evidence is observational until the 14-day promotion gate passes.
INTRADAY_CROSS_VENUE_MODE=shadow
INTRADAY_HYPERLIQUID_ENABLED=true
INTRADAY_HYPERLIQUID_METADATA_INTERVAL=30

# Optional Telegram delivery. Keep real values in .env.intraday, which is ignored by Git.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Model API keys never belong in this env file. Add them through `intraday provider add`;
# the worker receives the 0600 profile file read-only and the web service never mounts it.
