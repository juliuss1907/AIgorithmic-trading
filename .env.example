# Intraday v1 is deliberately paper-only and BTCUSDT-only.
INTRADAY_MODE=paper
INTRADAY_PROVIDER=stub
INTRADAY_SYMBOL=BTCUSDT
INTRADAY_PAPER_BALANCE=10000
# Deterministic risk/mark loop. This path never calls a model.
INTRADAY_INTERVAL_SECONDS=5
# Market-data and decision cadences.
INTRADAY_ORDER_BOOK_INTERVAL_SECONDS=15
INTRADAY_PERP_DECISION_INTERVAL_SECONDS=30
INTRADAY_DERIVATIVES_INTERVAL_SECONDS=60
INTRADAY_COMPACT_SHADOW_INTERVAL_SECONDS=900
INTRADAY_DATABASE=/app/state/intraday/intraday.sqlite3
INTRADAY_LLM_ANALYSIS_INTERVAL=3600
# Daily retrospective and rule proposal hour in Asia/Ho_Chi_Minh.
INTRADAY_RETROSPECTIVE_HOUR_VIETNAM=9
# Start with `soak`. Change to `paper` only after `portfolio soak evaluate`
# passes and `portfolio activate-paper` has recorded that exact evaluation id.
PORTFOLIO_WORKER_MODE=soak
# Host directory bind used by Docker Compose. Its profile file must have mode 0600.
INTRADAY_PROVIDER_SECRETS_HOST_DIR=../../state/provider-secrets
INTRADAY_DASHBOARD_HOST=0.0.0.0
INTRADAY_DASHBOARD_PORT=8081

# Generate a long random value. This protects mutation endpoints; it is never shown by the UI.
INTRADAY_CONTROL_TOKEN=replace-with-a-long-random-token
# Dedicated Hermes operator credentials. Keep actions disabled through the
# initial 72-hour read-only soak and use different random values for each token.
INTRADAY_OPERATOR_READ_TOKEN=replace-with-a-different-long-random-read-token
INTRADAY_OPERATOR_ACTION_TOKEN=replace-with-a-different-long-random-action-token
INTRADAY_OPERATOR_ACTIONS_ENABLED=false
INTRADAY_OPERATOR_REQUEST_TTL_SECONDS=300
INTRADAY_NEWS_ENABLED=true
INTRADAY_NEWS_INTERVAL_SECONDS=1800

# Cross-venue evidence is observational until the 14-day promotion gate passes.
INTRADAY_CROSS_VENUE_MODE=shadow
INTRADAY_HYPERLIQUID_ENABLED=true
INTRADAY_HYPERLIQUID_METADATA_INTERVAL=30

# Optional Telegram delivery. Keep real values in .env.intraday, which is ignored by Git.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Model API keys never belong in this env file. Add them through `aigt provider setup`;
# the worker receives the 0600 profile file read-only and the web service never mounts it.
