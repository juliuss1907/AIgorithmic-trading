[Unit]
Description=BTCUSDT promoted paper trading cycle
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=6

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@UV_PATH@ run --frozen python -m lab.paper_worker --once
Restart=on-failure
RestartSec=10min
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
