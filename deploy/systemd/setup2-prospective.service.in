[Unit]
Description=ETH-NEAR-SOL prospective paper test (ADR-005), public data only, no orders
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=6h
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
# Same Telegram bot as the BTC paper timer; alerts are skipped when the file is absent.
EnvironmentFile=-%h/.config/system-trading/paper-alerts.env
ExecStart=@UV_PATH@ run --frozen python -m intraday.replay_v2.donchian_prospective scheduled
Restart=on-failure
RestartSec=30min
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
